#!/bin/sh
set -eu

staged=$(git diff --cached --name-only --diff-filter=ACMR)

if printf '%s\n' "$staged" | grep -Eq '^(index\.html|styles\.css|public/belivin-main-site/|\.impeccable/assets/belivin-main-site/)'; then
  echo 'BELIVIN main-site files are staged; verifying Mario visual approval...'
  node .impeccable/main-site-production-gate.mjs commit
fi
