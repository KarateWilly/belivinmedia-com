{
  "name": "belivinmedia-com",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "BELIVIN MEDIA static website and responsive release checks",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "gate:status": "node .impeccable/site-gate.mjs status",
    "gate:unlock": "node .impeccable/site-gate.mjs unlock",
    "gate:lock": "node .impeccable/site-gate.mjs lock",
    "gate:commit": "node .impeccable/site-gate.mjs commit",
    "handoff:check": "node .impeccable/session-handoff-check.mjs",
    "lint:html": "html-validate index.html datenschutz.html impressum.html",
    "lint:css": "csstree-validator styles.css && csstree-validator legal.css",
    "lint:js": "node --check .impeccable/responsive-qa.mjs && node --check .impeccable/session-handoff-check.mjs && node --check .impeccable/site-gate.mjs && node --check site.js",
    "lint:impeccable": "node .impeccable/vendor/detect.mjs index.html styles.css impressum.html datenschutz.html legal.css",
    "test": "node --test tests/*.test.mjs",
    "test:responsive": "node .impeccable/responsive-qa.mjs",
    "qa": "npm run lint:html && npm run lint:css && npm run lint:js && npm run lint:impeccable && npm run test && npm run test:responsive"
  },
  "devDependencies": {
    "csstree-validator": "4.0.1",
    "html-validate": "11.6.2",
    "playwright": "1.62.1",
    "typescript": "6.0.3"
  }
}
